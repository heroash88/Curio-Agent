{
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/pocketTtsWorker.bundle.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/faceTrackingWorker.bundle.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self)" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/stock-proxy/**",
        "function": {
          "functionId": "stockProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/stooq-proxy/**",
        "function": {
          "functionId": "stooqProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/quotes-proxy/**",
        "function": {
          "functionId": "quotesProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/facts-proxy/**",
        "function": {
          "functionId": "factsProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/rss-proxy",
        "function": {
          "functionId": "rssProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp-proxy",
        "function": {
          "functionId": "mcpProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp-oauth-proxy",
        "function": {
          "functionId": "mcpOAuthProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/openai-compatible-proxy",
        "function": {
          "functionId": "openAICompatibleProxy",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
